   "source": [
    "# Bar chart of observations and is_protected by category\n",
    "plt.figure(figsize=(10, 6))\n",
    "width = 0.35\n",
    "plt.bar(agg_is_protected.index, agg_is_protected['observations'], width, label='Observations')\n",
    "plt.bar(agg_is_protected.index, agg_is_protected['is_protected'], width, bottom=agg_is_protected['observations'], label='Protected')\n",
    "plt.xticks(agg_is_protected.index, agg_is_protected['category'], rotation=45)\n",
    "plt.xlabel(\"Category\")\n",
    "plt.ylabel(\"Count\")\n",
    "plt.title(\"Observations and Protected Status by Category\")\n",
