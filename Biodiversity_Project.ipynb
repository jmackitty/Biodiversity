   ],
   "source": [
    "\n",
    "\n",
    "#  Merge the `species` and `observations` dataframes on the `scientific_name` column\n",
    "merged_df = pd.merge(observations, species, on=\"scientific_name\")\n",
    "\n",
    "# Group the dataframe by `category` and calculate the sum of `is_protected` for each `category`\n",
    "agg_is_protected = merged_df.groupby(\"category\").sum(numeric_only=True).reset_index()\n",
    "\n",
    "# Group the dataframe by `park_name` and calculate the sum of `observations` for each park\n",
    "agg_observations = merged_df.groupby(\"park_name\").sum(numeric_only=True).reset_index()\n",
    "\n",
    "# Print the first 5 rows of the aggregated data\n",
    "print(agg_is_protected.head())\n",
    "print(agg_observations.head())\n",
    "\n",
    "# Print the column names and their data types of the aggregated data\n",
    "print(agg_is_protected.info())\n",
    "print(agg_observations.info())"
   ]
  },
