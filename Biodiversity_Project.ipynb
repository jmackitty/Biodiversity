   ],
   "source": [
    "# Read the CSV files into Pandas DataFrames\n",
    "observations = pd.read_csv("observations.csv\")\n",
    "species = pd.read_csv("species_info.csv\")\n",
    "print(observations.head())\n",
    "print(species.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "64ccec2f",
   "metadata": {},
   "outputs": [],
   "source": [
    "pd.set_option('display.max_rows', None)\n",
    "pd.set_option('display.max_columns', None)\n",
    "\n",
    "\n",
    "# Fill the missing values in `conservation_status` column of `species` dataframe with `No Status`\n",
    "species[\"conservation_status\"] = species[\"conservation_status\"].fillna(\"No Status\")\n",
    "\n",
    "# Create a new column `is_protected` in `species` dataframe which is True if `conservation_status` is not `No Status` and False otherwise\n",
    "species[\"is_protected\"] = species[\"conservation_status\"].apply(lambda x: False if x == \"No Status\" else True)\n",
    "\n",
    "# Drop the duplicated rows from `species` dataset\n",
    "species = species.drop_duplicates()\n",
    "\n",
    "# From the `common_names` column, remove the extra ' (Feral)' from the values `Domestic Cattle (Feral)`, `Domestic Sheep (Feral)`, `Feral Hog (Feral)`, `European Rabbit (Feral)`, and `Rock Dove (Feral)`\n",
    "species[\"common_names\"] = species[\"common_names\"].str.replace(r\" \\s*\\(Feral\\)\", \"\", regex=True)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "f7c17550",
   "metadata": {},
   "outputs": [
